[Unit]
Description=MCP DadosBR Ephemeral Docker GitHub Actions Runner Supervisor
Documentation=https://github.com/cristianoaredes/mcp-dadosbr/tree/main/infra/runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/dadosbr-runner
EnvironmentFile=/etc/dadosbr-runner/env
ExecStartPre=/opt/dadosbr-runner/setup-network-isolation.sh --apply
ExecStart=/usr/bin/python3 -B /opt/dadosbr-runner/supervisor.py
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78
TimeoutStopSec=60
KillMode=mixed

# Systemd sandboxing (compatible with Docker Unix socket + iptables/ip6tables ExecStartPre)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/run/xtables.lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dadosbr-runner-supervisor

[Install]
WantedBy=multi-user.target
