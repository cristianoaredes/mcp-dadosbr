# Copy to /etc/dadosbr-runner/env with permissions 0600 (root:root).
# NEVER commit a real token to Git.
#
# Required Fine-Grained PAT (https://github.com/settings/personal-access-tokens/new):
#   - Repository access: Only select repositories -> cristianoaredes/mcp-dadosbr
#   - Permissions:
#       * Actions: Read-only
#       * Administration: Read and write
#       * Metadata: Read-only
GITHUB_TOKEN=CHANGE_ME_FINE_GRAINED_PAT

GITHUB_REPO=cristianoaredes/mcp-dadosbr
RUNNER_IMAGE=dadosbr-runner:2.338.2
DOCKER_NETWORK=dadosbr-ci-isolated
POLL_INTERVAL_SECONDS=15
MAX_CONCURRENT=2
MAX_RUN_AGE_MINUTES=30
JOB_TIMEOUT_SECONDS=1200
IDLE_GRACE_SECONDS=60
CONTAINER_MEMORY=3g
CONTAINER_CPUS=2
CONTAINER_PIDS_LIMIT=512
LOG_LEVEL=INFO
